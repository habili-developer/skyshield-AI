APP_NAME=SkyShield AI LLM Prototype
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATA_PATH=data/sample_scenarios.json
RULES_PATH=data/rules/airspace_rules.md

# LLM modes:
# mock   -> works offline with templated responses
# ollama -> uses Ollama local API
LLM_PROVIDER=mock
LLM_MODEL=gemma3
LLM_BASE_URL=http://localhost:11434/api
LLM_TIMEOUT_SECONDS=60

ENABLE_CORS=true
CORS_ALLOW_ORIGINS=*
API_KEY=
DATABASE_PATH=data/skyshield.db
DATABASE_URL=sqlite:///data/skyshield.db

SKYSHIELD_API_BASE=http://localhost:8000
